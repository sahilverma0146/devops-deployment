pipeline {
    agent any

    parameters {
        string(
            name: 'DOCKERHUB_REPOSITORY',
            defaultValue: 'your-dockerhub-username/my-ngrok-app',
            description: 'Docker Hub repository, for example username/my-ngrok-app'
        )
    }

    environment {
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and push image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKERHUB_CREDENTIALS_ID,
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        trap 'docker logout >/dev/null 2>&1 || true' EXIT

                        printf '%s' "$DOCKERHUB_TOKEN" |
                            docker login --username "$DOCKERHUB_USERNAME" --password-stdin

                        docker build \
                            --file production/Dockerfile \
                            --target production \
                            --tag "$DOCKERHUB_REPOSITORY:$BUILD_NUMBER" \
                            --tag "$DOCKERHUB_REPOSITORY:latest" \
                            .

                        docker push "$DOCKERHUB_REPOSITORY:$BUILD_NUMBER"
                        docker push "$DOCKERHUB_REPOSITORY:latest"
                    '''
                }
            }
        }
    }
}